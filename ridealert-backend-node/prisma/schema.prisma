datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Fleet {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  drivers  Driver[]
  vehicles Vehicle[]
}

model User {
  id           String   @id @default(uuid())
  fleetId      String?
  email        String   @unique
  passwordHash String
  role         String   @default("OPERATOR") // OPERATOR | ADMIN
  createdAt    DateTime @default(now())

  fleet        Fleet?  @relation(fields: [fleetId], references: [id])
  alerts       Alert[]
}

model Driver {
  id                 String   @id @default(uuid())
  fleetId            String?
  name               String
  address            String?
  personalContact    String?
  parentContact      String?
  hasLicence         Boolean  @default(false)
  defaultVehicleType String   // TWO_WHEELER | TRUCK
  createdAt          DateTime @default(now())

  fleet   Fleet?   @relation(fields: [fleetId], references: [id])
  devices Device[]
  trips   Trip[]
  alerts  Alert[]
}

model Vehicle {
  id                 String   @id @default(uuid())
  fleetId            String?
  registrationNumber String   @unique
  vehicleType        String   // TWO_WHEELER | TRUCK
  createdAt          DateTime @default(now())

  fleet Fleet? @relation(fields: [fleetId], references: [id])
  trips Trip[]
}

model Device {
  id               String    @id @default(uuid())
  driverId         String?
  deviceIdentifier String    @unique
  appVersion       String?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trips    Trip[]
  syncLogs SyncLog[]
}

model Trip {
  id             String    @id @default(uuid())
  driverId       String?
  vehicleId      String?
  deviceId       String?
  startTimestamp DateTime
  endTimestamp   DateTime?
  status         String    @default("ACTIVE") // ACTIVE | COMPLETED
  createdAt      DateTime  @default(now())

  driver        Driver?        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id])
  device        Device?        @relation(fields: [deviceId], references: [id])
  fatigueEvents FatigueEvent[]
  syncLogs      SyncLog[]
}

model FatigueEvent {
  id              String   @id @default(uuid())
  tripId          String?
  eventTimestamp  DateTime
  fatigueLevel    String   // NORMAL | WARNING | CRITICAL
  primarySignal   String   // FACIAL | MOTION | BOTH
  eyeClosureScore Decimal?
  driftScore      Decimal?
  lightCondition  String   @default("NORMAL") // NORMAL | LOW
  latitude        Decimal?
  longitude       Decimal?
  createdAt       DateTime @default(now())

  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  alerts Alert[]
}

model Alert {
  id             String    @id @default(uuid())
  fatigueEventId String?
  driverId       String?
  severity       String    // WARNING | CRITICAL
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  fatigueEvent FatigueEvent? @relation(fields: [fatigueEventId], references: [id], onDelete: Cascade)
  driver       Driver?       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [acknowledgedBy], references: [id])
}

model SyncLog {
  id            String   @id @default(uuid())
  deviceId      String?
  tripId        String?
  recordsSynced Int      @default(0)
  syncStatus    String   // SUCCESS | PARTIAL | FAILED
  syncedAt      DateTime @default(now())

  device Device? @relation(fields: [deviceId], references: [id])
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
